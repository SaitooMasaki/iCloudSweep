{
  "manifest_version": 3,
  "name": "iCloudSweep - Bulk Delete iCloud Photos",
  "version": "1.0.0",
  "description": "Bulk delete your iCloud Photos. Free: 100 photos lifetime. Pro: unlimited.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.icloud.com/*",
    "https://api.lemonsqueezy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.icloud.com/photos*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "iCloudSweep",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
